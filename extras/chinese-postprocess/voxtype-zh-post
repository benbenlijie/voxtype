#!/usr/bin/env bash
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [[ ! -f "$script_dir/punc.js" ]]; then
  script_dir="${HOME:?HOME must be set}/.local/share/voice-suite/chinese-postprocess"
fi
input=$(cat)

if [[ -z "${input//[[:space:]]/}" ]]; then
  printf '%s' "$input"
  exit 0
fi

node_bin=$(command -v node 2>/dev/null || true)
if [[ -z "$node_bin" ]]; then
  printf '%s' "$input"
  exit 0
fi

result=$(printf '%s' "$input" | "$node_bin" --input-type=module -e '
import { pathToFileURL } from "node:url";
const scriptUrl = pathToFileURL(process.argv[1]);
const { processText, runPunctuationCommand } = await import(scriptUrl);
const input = await new Promise((resolve, reject) => {
  let value = "";
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (chunk) => { value += chunk; });
  process.stdin.on("end", () => resolve(value));
  process.stdin.on("error", reject);
});
const output = await processText(input, {
  toSimplified: async (text) => {
    const moduleUrl = new URL("./node_modules/opencc-js/dist/esm/full.js", scriptUrl);
    const { default: OpenCC } = await import(moduleUrl);
    return OpenCC.Converter({ from: "tw", to: "cn" })(text);
  },
  restorePunctuation: process.env.VOXTYPE_PUNCTUATION_COMMAND
    ? (text) => runPunctuationCommand(process.env.VOXTYPE_PUNCTUATION_COMMAND, text)
    : undefined,
});
process.stdout.write(output);
' "$script_dir/punc.js" 2>/dev/null)
status=$?

if [[ "$status" -ne 0 || -z "${result//[[:space:]]/}" ]]; then
  printf '%s' "$input"
else
  printf '%s' "$result"
fi
